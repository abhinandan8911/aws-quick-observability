# quick-observability configuration
#
# Copy to env/<name>.env and select it with QUICK_OBS_ENV=<name>:
#
#   cp env/example.env env/prod.env
#   $EDITOR env/prod.env
#   QUICK_OBS_ENV=prod npm run deploy
#
# Real environment variables always win over this file, so a one-off override works:
#
#   QUICK_OBS_ENV=prod QUICK_OBS_PREFIX=trial npm run deploy
#
# ---------------------------------------------------------------------------
# REQUIRED. No defaults. Synth fails with instructions if any is missing.
# ---------------------------------------------------------------------------

# 12-digit AWS account id hosting the Quick account.
# Optional under `cdk deploy`, which supplies it from your credentials, but the
# preflight/verify/query scripts do not run under the CDK CLI and need it.
QUICK_OBS_ACCOUNT_ID=

# Quick user to own the dashboard, topic, Space and agent. Must already exist.
# Use the exact form the API reports, which for federated identities includes the role:
#   aws quicksight list-users --aws-account-id <id> --namespace default \
#     --query 'UserList[].[UserName,Role]' --output table
# Examples: Admin/alice   AuthorPro/alice@example.com
QUICK_OBS_OWNER=

# S3 bucket of an existing CloudTrail trail. Required only when
# QUICK_OBS_AUDIT_SOURCE=existing-trail (the default).
#   aws cloudtrail describe-trails --query 'trailList[].[Name,S3BucketName,S3KeyPrefix]' --output table
# Set QUICK_OBS_AUDIT_SOURCE=own-trail instead if no usable trail exists.
QUICK_OBS_TRAIL_BUCKET=

# ---------------------------------------------------------------------------
# OPTIONAL. Shown with their defaults; delete any line to accept the default.
# ---------------------------------------------------------------------------

# Region the Quick account lives in. Vended log delivery is per Region, so this
# must match. Deliberately ignores AWS_REGION and CDK_DEFAULT_REGION -- see the
# comment in lib/config.ts for why.
QUICK_OBS_REGION=us-east-1

# AWS CLI profile. Leave empty to use the SDK's default credential resolution.
AWS_PROFILE=

# Prefixes every resource name, including the S3 bucket (which must be globally
# unique -- the account id is appended automatically).
QUICK_OBS_PREFIX=quick-obs

# Quick namespace. Almost always 'default'.
QUICK_OBS_NAMESPACE=default

# The account-wide Quick service role that Quick assumes to reach Athena/Glue/S3.
# Pre-existing and account-managed; this module attaches a scoped inline policy.
QUICK_OBS_SERVICE_ROLE=aws-quicksight-service-role-v0

# Which of the 7 vended log types to deliver. 'all', or a comma list of:
#   CHAT_LOGS,FEEDBACK_LOGS,AGENT_HOURS_LOGS,AGENT_METADATA_LOGS,
#   INDEX_USAGE_LOGS,KB_FILE_SYNC_LOGS,DLP_LOGS
QUICK_OBS_LOG_TYPES=all

# 'true' also delivers chat message bodies (prompt and response text).
# Off by default: that is customer content, and the dashboard does not need it.
QUICK_OBS_LOG_SENSITIVE=false

# Where Quick API audit events come from:
#   existing-trail  read a trail you already have (default; reads AND writes, has history)
#   own-trail       this module creates its own trail (portable; costs a 2nd copy of events)
#   eventbridge     EventBridge -> Firehose (writes only -- misses ~96% of activity)
#   none            no audit table
QUICK_OBS_AUDIT_SOURCE=existing-trail

# Key prefix on that trail, if it has one. Empty for most trails.
QUICK_OBS_TRAIL_PREFIX=

# Whose CloudTrail logs to read. Differs from the target account for an org trail.
QUICK_OBS_TRAIL_ACCOUNT_ID=

# How often the Quick-only filter runs, and how far back each run looks.
# The lookback must be at least 2x the schedule interval -- enforced at synth time,
# because too short a window drops events silently and unrecoverably.
QUICK_OBS_MATERIALISE_SCHEDULE=rate(1 hour)
QUICK_OBS_MATERIALISE_LOOKBACK_HOURS=3

# Bump to replace the Quick topic. CloudFormation cannot update one in place, so a
# changed topic definition needs a new logical resource. Start at 1 for a fresh account.
QUICK_OBS_TOPIC_REVISION=1

# 'false' skips the CloudWatch Logs destination and delivers only to S3. Keeping it
# on is recommended: log streams appear within seconds, which is the fastest proof
# that delivery works, whereas S3 buffers for ~5 minutes.
QUICK_OBS_CLOUDWATCH=true

# CloudWatch Logs retention in days. S3 is the long-term store.
QUICK_OBS_RETENTION_DAYS=90
